{
    "framework": "vite",
    "installCommand": "npm install",
    "buildCommand": "npm run build --workspace web",
    "outputDirectory": "apps/web/dist",
    "rewrites":  [
                     {
                         "source":  "/planet/performance-powerboats",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/planet/performance-powerboats/board",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/planet/performance-powerboats/tech/:id",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/planet/performance-powerboats/project/:id",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/planet/demo/pest-control",
                         "destination":  "/planet/demo/pest-control/index.html"
                     },
                     {
                         "source":  "/planet/okie-dokie-softwash",
                         "destination":  "/planet/okie-dokie-softwash/index.html"
                     },
                     {
                         "source":  "/planet/okeechobee",
                         "destination":  "/planet/okeechobee/index.html"
                     },
                     {
                         "source":  "/planet/vz-professional-lawncare",
                         "destination":  "/planet/vz-professional-lawncare/index.html"
                     },
                     {
                         "source":  "/onlytheessentials",
                         "destination":  "/onlytheessentials/index.html"
                     },
                     {
                         "source":  "/((?!api/).*)",
                         "destination":  "/index.html"
                     }
                 ]
}


