{
    "framework":  "vite",
    "installCommand":  "npm install",
    "buildCommand":  "npm run build --workspace web",
    "outputDirectory":  "apps/web/dist",
    "rewrites":  [
                     {
                         "source":  "/planet/performance-powerboats",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/planet/performance-powerboats/board",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/planet/performance-powerboats/tech/:id",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/planet/performance-powerboats/project/:id",
                         "destination":  "/index.html"
                     },
                     {
                         "source":  "/planet/demo/pest-control",
                         "destination":  "/planet/demo/pest-control/index.html"
                     },
                     {
                         "source":  "/planet/okie-dokie-softwash",
                         "destination":  "/planet/okie-dokie-softwash/index.html"
                     },
                     {
                         "source":  "/planet/okeechobee",
                         "destination":  "/planet/okeechobee/index.html"
                     },
                     {
                         "source":  "/planet/vz-professional-lawncare",
                         "destination":  "/planet/vz-professional-lawncare/index.html"
                     },
                     {
                         "source":  "/onlytheessentials",
                         "destination":  "/onlytheessentials/index.html"
                     },
                     {
                         "source":  "/((?!api/).*)",
                         "destination":  "/index.html"
                     }
                 ],
    "redirects":  [
                      {
                          "source":  "/",
                          "has":  [
                                      {
                                          "type":  "host",
                                          "value":  "performancepowerboatsfl.com"
                                      }
                                  ],
                          "destination":  "/planet/performance-powerboats",
                          "permanent":  false
                      },
                      {
                          "source":  "/",
                          "has":  [
                                      {
                                          "type":  "host",
                                          "value":  "www.performancepowerboatsfl.com"
                                      }
                                  ],
                          "destination":  "/planet/performance-powerboats",
                          "permanent":  false
                      },
                      {
                          "source":  "/api/okeechobee-meat-market-order",
                          "destination":  "/api/okeechobee-meat-market?route=order",
                          "permanent":  false
                      },
                      {
                          "source":  "/api/okeechobee-meat-market-seller-manage",
                          "destination":  "/api/okeechobee-meat-market?route=seller-manage",
                          "permanent":  false
                      },
                      {
                          "source":  "/api/okeechobee-meat-market-square-connect",
                          "destination":  "/api/okeechobee-meat-market?route=square-connect",
                          "permanent":  false
                      },
                      {
                          "source":  "/api/okeechobee-meat-market-square-callback",
                          "destination":  "/api/okeechobee-meat-market?route=square-callback",
                          "permanent":  false
                      }
                  ]
}
